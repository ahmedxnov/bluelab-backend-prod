.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Generated build output — regenerated from api/openapi.yaml on every commit gate
# run and diffed against what the server serves. Never edited by hand (ADR-0035).
contracts/generated/*
!contracts/generated/.gitkeep

# Generated RLS policies — emitted from the per-module policy-class declarations
# (ADR-0031). Nobody writes a policy by hand.
sql/policies/generated/*
!sql/policies/generated/.gitkeep

# mutmut's working tree: a full copy of src/ plus a .meta sidecar per mutated file
# and the CI/CD stats JSON. Regenerated by every `mutmut run`. The number that
# survives the run is kept in tools/baselines/check-mutation-score.json, which IS
# tracked — that is the ratchet.
mutants/

# Local virtualenv created to run the generator offline.
.venv/
