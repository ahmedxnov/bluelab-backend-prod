# Local configuration template (infra/00 §1: "local — .env from a template; never
# real prod keys").
#
# Two rules that are enforced, not merely intended:
#   * No secret VALUE ever lands in code, image, or log — the commit gate's secret
#     scan fails the build if one does (SEC-019, pipeline/02 §2 row 9).
#   * No setting here may be branched on by the rollout tier. The tier lives in
#     composition and configuration values only; a tier-conditional application
#     branch fails the build (SEC-026, infra C-6).
#
# Staging and prod read from the secret store through the application's own role,
# never from a file and never through the pipeline.

# --- plane ------------------------------------------------------------------
BLUELAB_PLANE=api                       # api | worker | sweeper
BLUELAB_ENV=local                       # local | staging | prod

# --- C-10 transactional store (ADR-0022) ------------------------------------
# PostgreSQL 16. Assumes a transaction-mode pooler, so session state must be
# per-transaction only (data/04 §8). The app role is non-superuser and does NOT
# hold BYPASSRLS — only the migration role does.
DATABASE_URL=postgresql+asyncpg://bluelab_app:bluelab@localhost:5432/bluelab
MIGRATION_DATABASE_URL=postgresql+psycopg://bluelab:bluelab@localhost:5432/bluelab

# --- C-13 coordination store (ADR-0024) -------------------------------------
# Sessions, the single-live-call lease, the live-call registry, placement.
# Volatile by design — nothing here survives its call.
VALKEY_URL=redis://localhost:6379/0

# --- C-11 object store (ADR-0025) -------------------------------------------
# The S3 API is the contract; the implementation is configuration.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=bluelab-local
OBJECT_STORE_REGION=eu-south-1
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_PRESIGN_SECONDS=300
ERASURE_LEDGER_BUCKET=bluelab-erasure-ledger
LIFECYCLE_HISTORY_BUCKET=bluelab-lifecycle-history
LIFECYCLE_HISTORY_KMS_KEY_ID=
ERASURE_BACKUP_LEDGER_BUCKET=bluelab-erasure-ledger-backup
ERASURE_BACKUP_ENDPOINT=
ERASURE_BACKUP_REGION=
ERASURE_BACKUP_ACCESS_KEY=
ERASURE_BACKUP_SECRET_KEY=
ERASURE_LEDGER_KMS_KEY_ID=

# --- bounded external calls (architecture/04 §2) ----------------------------
DEPENDENCY_TIMEOUT_SECONDS=5
DEPENDENCY_MAX_ATTEMPTS=3
DEPENDENCY_BACKOFF_BASE_SECONDS=0.1
DEPENDENCY_BACKOFF_MAX_SECONDS=1
DEPENDENCY_CIRCUIT_FAILURE_THRESHOLD=5
DEPENDENCY_CIRCUIT_RECOVERY_SECONDS=30

# --- C-12 work plane (ADR-0023) ---------------------------------------------
WORKER_QUEUES=dispatch_email,maintenance
# Maintenance cron schedules run in UTC; set the worker process TZ=Etc/UTC.
WORKER_CONCURRENCY=10
WORKER_COMPATIBILITY_DELAY_SECONDS=5

# --- C-14 email (ADR-0026) ---------------------------------------------------
# Local: Mailpit. Staging: SES sandbox, verified recipients only. Prod: SES
# production access, eu-south-1.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_SENDER=no-reply@example.com
EMAIL_REGION=eu-south-1
EMAIL_SNS_TOPIC_ARN=
PUBLIC_APP_URL=http://localhost:5173

# Generate two independent Base64-encoded 32-byte local keys. Deployed
# environments use the KMS key ids instead; never reuse either key across roles.
EMAIL_DELIVERY_LOCAL_KEY=
EMAIL_DELIVERY_KMS_KEY_ID=
OPS_TOTP_LOCAL_KEY=
OPS_TOTP_KMS_KEY_ID=

# --- identity/session policy (security/04 §3) -------------------------------
SESSION_IDLE_SECONDS=43200
SESSION_ABSOLUTE_SECONDS=604800
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_THROTTLE_IDENTIFIER_ATTEMPTS=5
AUTH_BACKOFF_BASE_SECONDS=1
AUTH_BACKOFF_MAX_SECONDS=300
AUTH_THROTTLE_SOURCE_ATTEMPTS=10
AUTH_THROTTLE_SOURCE_WINDOW_SECONDS=60
PASSWORD_RESET_REQUEST_WINDOW_SECONDS=3600
PASSWORD_RESET_REQUEST_IDENTIFIER_ATTEMPTS=3
PASSWORD_RESET_REQUEST_SOURCE_ATTEMPTS=10
PASSWORD_RESET_COMPLETE_WINDOW_SECONDS=3600
PASSWORD_RESET_COMPLETE_SOURCE_ATTEMPTS=10
OPS_THROTTLE_ATTEMPTS=5
OPS_THROTTLE_WINDOW_SECONDS=60

# --- The call-plane seam (ADR-0071) -----------------------------------------
# The ONE shared secret with the independently deployed bluelab-agent-prod.
# HMAC-SHA256 binds method, path, timestamp, and exact raw-body digest. Must equal the
# agent's AGENT_HMAC_SECRET.
AGENT_HMAC_SECRET=

# --- C-1 media transport (ADR-0014) -----------------------------------------
# Server-side only: token minting, egress (the application plane executes egress
# with its own credentials — the runtime only requests it), webhook verification.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- C-6 / C-7 model capabilities (ADR-0018) --------------------------------
# Evaluator and generation. Turn-path model keys (C-2/C-3/C-4) are NOT here —
# they belong to the call plane, which is a separate deployment unit.
EVALUATOR_API_KEY=
GENERATION_API_KEY=

# --- C-8 document extraction (ADR-0020) -------------------------------------
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=

# --- C-16 observability (ADR-0027) ------------------------------------------
# Content-free by construction: identifiers and timings, never content
# (observability/01 §5, SEC-024).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=bluelab-backend

# --- vendor fixture mode (infra/00 §3) --------------------------------------
# Deterministic tests without spend; the fixture set is versioned with the repo.
VENDOR_FIXTURE_MODE=true
